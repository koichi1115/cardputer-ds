[Unit]
Description=CardputerZero DS top screen (external 2.8" LCD)
After=fb_load.service

[Service]
Type=simple
# 外付け液晶のドライバが読み込まれるまで最大30秒待つ
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /dev/dri/ds-external ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/python3 /opt/cardputer-ds/app/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
